# Drishti — environment variables
# Copy to .env for local development (never commit real values)

# Required: Gemini API key for vision analysis
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: GCP project for Firestore persistence
GCP_PROJECT=your-gcp-project-id

# Optional: admin credentials for /admin panel (auto-generated if omitted)
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-here
